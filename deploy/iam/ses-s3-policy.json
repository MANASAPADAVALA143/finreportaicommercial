{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EmailIntakeS3",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::finreportai-email-intake",
        "arn:aws:s3:::finreportai-email-intake/*"
      ]
    },
    {
      "Sid": "SesSendOptional",
      "Effect": "Allow",
      "Action": [
        "ses:SendEmail",
        "ses:SendRawEmail"
      ],
      "Resource": "*"
    }
  ]
}
